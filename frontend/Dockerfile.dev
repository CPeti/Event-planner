# Dockerfile.dev for frontend
FROM node:20-alpine

WORKDIR /app

# Install dependencies first (cached unless package.json changes)
COPY package.json package-lock.json ./
RUN npm ci

# Expose Vite's default port
EXPOSE 5173

# The actual source code and node_modules will be synced by Tilt, 
# but providing a default run command is helpful.
# We also COPY the source files so they are present in the image immediately.
COPY . .

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
